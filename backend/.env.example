# Copy this file to .env and fill in real values. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=glowguide_app
DB_PASSWORD=
DB_NAME=glowguide

# Generate a long random string for this, e.g.: openssl rand -hex 64
JWT_SECRET=

# How long an auth session stays valid
JWT_EXPIRES_IN=7d

PORT=4000

# Comma-separated list of origins allowed to call this API with credentials.
# Set this to wherever the GlowGuide frontend is served from.
# CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

NODE_ENV=development
